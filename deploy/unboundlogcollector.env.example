# Copy this file to /etc/unboundlogcollector/unboundlogcollector.env
# Keep it owned by root and readable only by the service account group.

UNBOUND_LOG_FILE=/var/lib/unbound/log/unbound.log
UNBOUND_DB_HOST=localhost
UNBOUND_DB_PORT=3306
UNBOUND_DB_USER=admin
UNBOUND_DB_PASSWORD=change-me
UNBOUND_DB_NAME=dns
UNBOUND_POLL_INTERVAL=0.2
UNBOUND_START_FROM_END=true
UNBOUND_VERBOSITY=1
UNBOUND_LOG_LEVEL=INFO
